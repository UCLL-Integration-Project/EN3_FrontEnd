# Copy to .env.local and adjust for your environment.
# Base URL of the running EN3_BackEnd API.
# - Browser on the same machine: http://localhost:<backend-port>
# - Android emulator:             http://10.0.2.2:<backend-port>
# - Physical device on Wi-Fi:     http://<your-LAN-IP>:<backend-port>
NEXT_PUBLIC_API_URL=http://localhost:3000
