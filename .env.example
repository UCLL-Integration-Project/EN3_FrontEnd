# Copy to .env.local and adjust for your environment.
# Base URL of the running EN3_BackEnd API.
# - Browser on the same machine: http://localhost:<backend-port>
# - Android emulator:             http://10.0.2.2:<backend-port>
# - Physical device on Wi-Fi:     http://<your-LAN-IP>:<backend-port>
NEXT_PUBLIC_API_URL=http://localhost:3000

# Web push (VAPID) public key, base64url-encoded.
# The matching private key lives on the backend; it never leaves the server.
# Generate a pair with: npx web-push generate-vapid-keys
# Leave unset to disable the push-notification UI gracefully.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BOwPdGRQJYrd_Uylvjd4fLO_fleDYgcjt-Hezy_cDOW5FBJhVhE_GslZhRhYfOhDB_hFPdYY6ni0UxrlgkqBcMc
